@model hamalba.ViewModels.ReportListViewModel
@{
    ViewData["Title"] = "Prijave korisnika";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-shield-exclamation me-2"></i>Upravljanje prijavama korisnika</h2>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-people-fill me-1"></i> Upravljanje korisnicima
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header bg-light">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-0">Filteri</h5>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-danger me-2">@Model.Reports.Count(r => !r.Pregledano) nepregledane</span>
                    <span class="badge bg-secondary">@Model.Reports.Count(r => r.Pregledano) pregledane</span>
                </div>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control" placeholder="Pretraži..." value="@Model.SearchTerm">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="showReviewed" id="showReviewed" value="true" @(Model.ShowReviewed ? "checked" : "")>
                        <label class="form-check-label" for="showReviewed">Prikaži i pregledane</label>
                    </div>
                </div>
                <div class="col-md-3 text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel-fill me-1"></i> Filtriraj
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i> Resetuj
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header bg-light">
            <h5 class="mb-0">Lista prijava</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Reports.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Datum prijave</th>
                                <th>Prijavio</th>
                                <th>Prijavljeni</th>
                                <th>Oglas</th>
                                <th>Status</th>
                                <th>Akcije</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model.Reports)
                            {
                                <tr class="@(!report.Pregledano ? "table-warning" : "")">
                                    <td>#@report.ReportId</td>
                                    <td>@report.DatumPrijave.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@report.Reporter.Ime @report.Reporter.Prezime</td>
                                    <td>@report.ReportedUser.Ime @report.ReportedUser.Prezime</td>
                                    <td>
                                        @if (report.RelatedOglas != null)
                                        {
                                            <a asp-controller="Oglasi" asp-action="Detalji" asp-route-id="@report.RelatedOglas.OglasId">
                                                @report.RelatedOglas.Naslov
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (report.Status)
                                        {
                                            case 0:
                                                <span class="badge bg-secondary">Na čekanju</span>
                                                break;
                                            case 1:
                                                <span class="badge bg-success">Prihvaćena</span>
                                                break;
                                            case 2:
                                                <span class="badge bg-danger">Odbijena</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@report.ReportId" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> Detalji
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox-fill" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="mt-3 text-muted">Nema pronađenih prijava.</p>
                </div>
            }
        </div>
    </div>
</div>